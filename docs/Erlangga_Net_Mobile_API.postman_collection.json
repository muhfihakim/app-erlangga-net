{
	"info": {
		"_postman_id": "8e3c12a4-b01f-4cb1-93da-189fec0e3861",
		"name": "Erlangga Net - Mobile Pelanggan API",
		"description": "Koleksi Postman API Mobile Pelanggan (Android & iOS) Erlangga Net untuk environment Staging.\n\n### Cara Pakai:\n1. Jalankan request **1.1 Login Pelanggan**.\n2. Token akan otomatis tersimpan ke variabel `{{token}}`.\n3. Request lainnya sudah terkonfigurasi otomatis menggunakan Bearer Token tersebut.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "https://stage.erlangga.net/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Autentikasi",
			"item": [
				{
					"name": "1.1 Login Pelanggan",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.collectionVariables.set(\"token\", jsonData.token);",
									"        console.log(\"Token berhasil disimpan ke variabel: \" + jsonData.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id_pelanggan\": \"23114957687\",\n  \"password\": \"123\",\n  \"device_name\": \"Postman Test Client\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Login menggunakan ID Pelanggan atau Username PPPoE dan Password PPPoE. Token otomatis disimpan ke variabel {{token}}."
					},
					"response": []
				},
				{
					"name": "1.2 Profil Sesi Aktif (/me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"me"
							]
						},
						"description": "Mengecek apakah sesi token masih aktif dan mengambil ringkasan akun pelanggan saat ini."
					},
					"response": []
				},
				{
					"name": "1.3 Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"logout"
							]
						},
						"description": "Menghapus token akses sesi aktif dari server."
					},
					"response": []
				}
			]
		},
